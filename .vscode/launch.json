{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Windows App (PDB)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bazel-out/x64_windows-dbg/bin/native_ui_app.exe",
            "symbolSearchPath": "${workspaceFolder}/bazel-out/x64_windows-dbg/bin/",
            "preLaunchTask": "Bazel Build Debug",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "console": "externalTerminal"
        }
    ]
}
