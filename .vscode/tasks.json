{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel Build platformX Lib",
      "type": "shell",
      "windows": { "command": "bazel build --compilation_mode=dbg --strip=never //src:platformX.dll" },
      "linux":   { "command": "bazel build --compilation_mode=dbg --strip=never //src:platformX.so" },
      "osx":     { "command": "bazel build --compilation_mode=dbg --strip=never //src:platformX.dylib" },
    },
    {
      "label": "Bazel Build native_ui_app Example App",
      "type": "shell",
      "command": "bazel build --compilation_mode=dbg --strip=never //:native_ui_app"
    },
    {
        "label": "Bazel Build Debug",
        "dependsOn": [
            "Bazel Build platformX Lib",
            "Bazel Build native_ui_app Example App"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    {
      "label": "Bazel Run native_ui_app",
      "type": "shell",
      "command": "bazel run //:native_ui_app"
    }
  ]
}